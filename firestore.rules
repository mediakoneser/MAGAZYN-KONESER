rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Parts collection:
    // Anyone can read and write parts inventory (or authenticated station users), 
    // ensuring offline-first & guest/station terminal usage without permission errors.
    match /parts/{partId} {
      allow read, write: if true;
    }

    // User profiles: owner only
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Valuations collection
    match /valuations/{valId} {
      allow read, write: if true;
    }

    // Car intake requests
    match /car_intakes/{intakeId} {
      allow read, write: if true;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
